# ==============================================================================
# CampusConnect - MySQL Database Configuration Template
# ==============================================================================
# Copy this file to 'db.properties' (or place in src/main/resources/db.properties)
# and replace placeholder values with your local or production database credentials.
#
# Alternatively, configure via environment variables:
#   DB_URL, DB_USER, DB_PASSWORD
# or JVM system properties:
#   -Ddb.url=... -Ddb.user=... -Ddb.password=...

# JDBC connection URL (specifying database name, SSL, and timezone flags)
db.url=jdbc:mysql://localhost:3306/campus_connect?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Database user name
db.user=your_db_username_here

# Database password
db.password=your_db_password_here
